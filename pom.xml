<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>liberty-tls-apache5</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>liberty-tls-apache5</name>
    <description>HTTPS probes using Liberty TLS with Apache HttpClient 5 and the JDK HttpClient</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <servlet.version>6.1.0</servlet.version>
        <httpclient5.version>5.6.5</httpclient5.version>
        <liberty.api.ssl.version>1.9.119</liberty.api.ssl.version>
        <liberty.runtime.version>26.0.0.11</liberty.runtime.version>
        <liberty.maven.plugin.version>3.12.5</liberty.maven.plugin.version>
        <war.plugin.version>3.5.1</war.plugin.version>
    </properties>

    <dependencies>
        <!-- Servlet API, supplied by Liberty at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Liberty SSL API (com.ibm.websphere.ssl.JSSEHelper), supplied by Liberty at runtime -->
        <dependency>
            <groupId>com.ibm.websphere.appserver.api</groupId>
            <artifactId>com.ibm.websphere.appserver.api.ssl</artifactId>
            <version>${liberty.api.ssl.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache HttpClient 5, bundled in the WAR -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${httpclient5.version}</version>
        </dependency>

        <!-- Routes HttpClient's SLF4J logging to java.util.logging (Liberty's logs); matches slf4j-api 1.7.36 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>1.7.36</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${war.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>${liberty.maven.plugin.version}</version>
                <configuration>
                    <serverName>tlsServer</serverName>
                    <appsDirectory>apps</appsDirectory>
                    <runtimeArtifact>
                        <groupId>io.openliberty</groupId>
                        <artifactId>openliberty-runtime</artifactId>
                        <version>${liberty.runtime.version}</version>
                        <type>zip</type>
                    </runtimeArtifact>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
